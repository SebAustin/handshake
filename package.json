{
  "name": "handshake",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "next typegen && tsc --noEmit",
    "spike:paypal": "tsx --env-file=.env.local scripts/paypal-spike.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file=.env.local ./node_modules/drizzle-kit/bin.cjs migrate",
    "test:int": "VITEST_INTEGRATION=1 node --env-file=.env.local ./node_modules/vitest/vitest.mjs run",
    "check:criteria": "tsx --env-file=.env.local scripts/check-criteria.ts",
    "check:agents": "tsx --env-file=.env.local scripts/check-agents.ts",
    "inspect:deal": "tsx --env-file=.env.local scripts/inspect-deal.ts",
    "seed:deal": "tsx --env-file=.env.local scripts/seed-deal.ts",
    "clean:test-deals": "tsx --env-file=.env.local scripts/clean-test-deals.ts",
    "eval:arbiter": "VITEST_EVAL=1 node --env-file=.env.local ./node_modules/vitest/vitest.mjs run src/arbiter"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.98",
    "@ai-sdk/mcp": "^2.0.92",
    "@neondatabase/serverless": "^1.2.0",
    "@paypal/paypal-js": "11.3.0",
    "ai": "^7.0.164",
    "drizzle-orm": "^0.45.4",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.0.5",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=24"
  }
}
